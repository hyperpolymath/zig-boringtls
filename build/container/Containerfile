#
# zig-boringtls build-and-test image.
#
# zig-boringtls is a library, so this image does not run a service: it
# builds the pinned BoringSSL and the wrapper, then runs the test suite.
# Network is needed only while the image is built (Wolfi packages, the
# SHA-256-verified Zig toolchain, and the hash-pinned BoringSSL fetch).
# Run the tests with networking disabled; they only use loopback.
#
#   podman build -t zig-boringtls-test -f build/container/Containerfile .
#   podman run --rm --network=none zig-boringtls-test
#
# The template's service scaffolding beside this file (entrypoint.sh,
# compose*, stapeln/) is not used by this repository.

# Wolfi base, pinned by digest (resolve a newer one deliberately).
FROM cgr.dev/chainguard/wolfi-base@sha256:256c88bb066424045021090932d50be93c8e3f2ce3586707702a401b146f3e43

ARG ZIG_VERSION=0.17.0
ARG ZIG_SHA256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026

LABEL org.opencontainers.image.title="zig-boringtls-test" \
      org.opencontainers.image.description="Build-and-test image for zig-boringtls (thin typestate Zig wrapper over BoringSSL)" \
      org.opencontainers.image.source="https://github.com/hyperpolymath/zig-boringtls" \
      org.opencontainers.image.licenses="MPL-2.0"

# bash + openssl: the per-build fixture generator; curl + xz: the toolchain fetch.
RUN apk add --no-cache bash openssl curl xz ca-certificates
RUN curl -fsSLo /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
 && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
 && tar -C /opt -xf /tmp/zig.tar.xz \
 && mkdir -p /usr/local/bin \
 && ln -s "/opt/zig-x86_64-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig \
 && rm /tmp/zig.tar.xz

RUN adduser -D build
USER build
WORKDIR /home/build/ffi
COPY --chown=build:build src/interface/ffi/ .
# Fetch (Zig verifies the content hash in build.zig.zon), then build with
# networking off so nothing else can be pulled in.
RUN zig build --fetch
RUN --network=none zig build install

CMD ["zig", "build", "test", "--summary", "all"]
